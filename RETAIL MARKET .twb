      <column caption='Net Revenue' datatype='real' name='[Calculation_0979488551202816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([quantity] * [unit_price]) * (1.0 - [discount_percent]))' />
      </column>
      <column caption='Net Profit' datatype='real' name='[Calculation_0979488552247297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM((([quantity] * [unit_price]) * (1.0 - [discount_percent])) - ([quantity] * [unit_cost]))' />
      </column>
